PORT=4000
MONGO_URI=mongodb://localhost:27017/kadai
CORS_ORIGIN=http://localhost:3000

# Use long random strings in every real environment (store them in Azure Key Vault)
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Razorpay test keys from https://dashboard.razorpay.com (Test mode).
# Leave blank to use the built-in mock gateway for local development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Azure Service Bus. Leave blank to use the in-process event bus.
SERVICEBUS_CONNECTION=
SERVICEBUS_TOPIC=orders

# Minutes an order may wait for payment before its reserved stock is released
PAYMENT_TIMEOUT_MINUTES=15
